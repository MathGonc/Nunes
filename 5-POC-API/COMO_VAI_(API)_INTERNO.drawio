<mxfile host="drawio" agent="Claude Code"><diagram id="Como-vai-ficar-(API)" name="Como vai ficar (API)"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;COMO VAI FICAR (API)&lt;/b&gt; — os caminhos que o fluxo automático percorre" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1640" height="40" as="geometry"/></mxCell><mxCell id="v2" value="TOTVS RM ⇄ &lt;b&gt;nosso servidor (1 servidor)&lt;/b&gt; ⇄ RP Info · cada linha é um caminho do nosso servidor e o caminho do fornecedor que ele chama" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1640" height="26" as="geometry"/></mxCell><mxCell id="v3" value="Nossos caminhos são &lt;b&gt;propostos (fictícios)&lt;/b&gt;. Os do RP Info vêm da documentação pública RP Services v2.0.89. Os do RM seguem o padrão wsDataServer da TOTVS; o DataServer exato será definido com o implantador (S6)." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="1640" height="24" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="36" height="24" as="geometry"/></mxCell><mxCell id="v5" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt; caminho nosso que &lt;b&gt;vai existir&lt;/b&gt; (só depende de nós)' style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="62" y="112" width="270" height="36" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="340" y="118" width="36" height="24" as="geometry"/></mxCell><mxCell id="v7" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ S1&lt;/b&gt;&lt;/font&gt; caminho nosso que &lt;b&gt;falta validar&lt;/b&gt;&lt;br&gt;(código = pergunta que decide)' style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="382" y="112" width="270" height="36" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="660" y="118" width="36" height="24" as="geometry"/></mxCell><mxCell id="v9" value="caminho do fornecedor &lt;b&gt;documentado&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="702" y="112" width="230" height="36" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="118" width="36" height="24" as="geometry"/></mxCell><mxCell id="v11" value='&lt;font color="#c0392b"&gt;&lt;b&gt;⚠ &lt;/b&gt;&lt;/font&gt;do fornecedor: existe, &lt;b&gt;falta confirmar&lt;/b&gt;&lt;br&gt;se serve para a folha' style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="982" y="112" width="270" height="36" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1262" y="130" as="sourcePoint"/><mxPoint x="1312" y="130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v13" value="seta = quem chama quem&lt;br&gt;tracejado = depende de confirmação" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1320" y="112" width="300" height="36" as="geometry"/></mxCell><mxCell id="v14" value="TOTVS RM · origem da folha" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#0e8088;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="74" y="172" width="380" height="48" as="geometry"/></mxCell><mxCell id="v15" value="NOSSO SERVIDOR · 1 servidor · https://integra.nunes.local/api/v1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#7b5ea7;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="172" width="600" height="48" as="geometry"/></mxCell><mxCell id="v16" value="RP INFO · RP Services API (v2.0.89)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#5f8f4e;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1134" y="172" width="520" height="48" as="geometry"/></mxCell><mxCell id="v17" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#eaf6f7;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="74" y="220" width="380" height="1132" as="geometry"/></m