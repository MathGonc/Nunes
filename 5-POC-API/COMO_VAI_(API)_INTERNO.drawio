"1"><mxGeometry x="20" y="1124" width="44" height="148" as="geometry"/></mxCell><mxCell id="v26" value="" style="line;strokeWidth=1;dashed=1;strokeColor=#9e9e9e;html=1;" vertex="1" parent="1"><mxGeometry x="64" y="1119" width="1590" height="10" as="geometry"/></mxCell><mxCell id="v27" value="SEMPRE" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;horizontal=0;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1272" width="44" height="80" as="geometry"/></mxCell><mxCell id="v28" value="" style="line;strokeWidth=1;dashed=1;strokeColor=#9e9e9e;html=1;" vertex="1" parent="1"><mxGeometry x="64" y="1267" width="1590" height="10" as="geometry"/></mxCell><mxCell id="v29" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;b&gt;Credenciais guardadas no servidor&lt;/b&gt;&lt;br&gt;token do RP Info e usuário do RM, renovados sozinhos' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="234" width="540" height="52" as="geometry"/></mxCell><mxCell id="v30" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v1.2/auth&lt;/b&gt;&lt;/font&gt;&lt;br&gt;devolve o token usado em todas as chamadas' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="234" width="480" height="52" as="geometry"/></mxCell><mxCell id="e31" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v32" value='&lt;b&gt;Usuário de serviço&lt;/b&gt; no RM&lt;br&gt;tipo de autenticação a definir &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S6&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="99" y="234" width="330" height="52" as="geometry"/></mxCell><mxCell id="e33" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v34" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ S7&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /eventos/rm/folha-fechada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o RM avisa que a folha fechou (se não avisar: agenda)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="316" width="540" height="52" as="geometry"/></mxCell><mxCell id="v35" value='&lt;b&gt;Aviso de folha fechada&lt;/b&gt;&lt;br&gt;o RM consegue avisar? &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S7&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="99" y="316" width="330" height="52" as="geometry"/></mxCell><mxCell id="e36" value="avisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v37" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/iniciar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;começa a carga: pelo aviso, pela agenda ou à mão' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="382" width="540" height="52" as="geometry"/></mxCell><mxCell id="v38" value='&lt;font face="Courier New"&gt;&lt;b&gt;/wsDataServer/IwsDataServer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;&lt;b&gt;ReadView&lt;/b&gt;&lt;/font&gt; · DataServer da folha &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S5 S6&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="99" y="382" width="330" height="52" as="geometry"/></mxCell><mxCell id="e39" value="lê a folha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v40" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/validar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;regras + de-para + débito = crédito por loja · &lt;b&gt;trava se algo não bater&lt;/b&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="448" width="540" height="52" as="geometry"/></mxCell><mxCell id="v41" value="&lt;i&gt;usa os caminhos de funcionários e cadastros (linha 2)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontColor=#666666;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="448" width="480" height="52" as="geometry"/></mxCell><mxCell id="v42" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/aprovar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;uma pessoa aprova o lote do mês' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="514" width="540" height="52" as="geometry"/></mxCell><mxCell id="v43" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ S1 S3&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/enviar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;grava os lançamentos: 17 documentos, 1 por loja' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="580" width="540" height="52" as="geometry"/></mxCell><mxCell id="v44" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v1.0/fde&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S1 S3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DocumentoFDE · contrapartidas[] = os lançamentos' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1154" y="580" width="480" height="52" as="geometry"/></mxCell><mxCell id="e45" value="envia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v43" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v46" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ só se S1 = não&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET /folha/{competencia}/arquivo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;plano B: gera o arquivo pronto, sem planilha' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="646" width="540" height="52" as="geometry"/></mxCell><mxCell id="v47" value="&lt;b&gt;Plano B&lt;/b&gt;: importar o arquivo gerado (Ctrl+D)&lt;br&gt;sem planilha e sem digitação" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="646" width="480" height="52" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v46" target="v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v49" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET /folha/{competencia}/conferencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;lê o que foi gravado e compara com o que foi enviado' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="712" width="540" height="52" as="geometry"/></mxCell><mxCell id="v50" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /v1.0/contabil/movimentos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;filtro por competência e loja a confirmar (R13)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="712" width="480" height="52" as="geometry"/></mxCell><mxCell id="e51" value="lê" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v49" target="v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v52" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ S2&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/estornar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;desfaz um envio inteiro (reprocesso)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="778" width="540" height="52" as="geometry"/></mxCell><mxCell id="v53" value='&lt;font face="Courier New"&gt;&lt;b&gt;PUT /v1.0/documento/cancelar&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;serve para cancelar um lote de folha?' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1154" y="778" width="480" height="52" as="geometry"/></mxCell><mxCell id="e54" value="cancela" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v52" target="v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v55" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ N2&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/pos-importacao&lt;/b&gt;&lt;/font&gt;&lt;br&gt;bancos, pensão e baixas das contas totalizadoras' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="844" width="540" height="52" as="geometry"/></mxCell><mxCell id="v56" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v2.0/financeiro/pendenciasFinanceiras/baixarPendenciaFin&lt;/b&gt;&lt;/font&gt;&lt;br&gt;+ &lt;font face="Courier New"&gt;&lt;b&gt;pendencias[].portador&lt;/b&gt;&lt;/font&gt; no FDE &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ R11 R12&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1154" y="844" width="480" height="52" as="geometry"/></mxCell><mxCell id="e57" value="baixa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v55" target="v56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v58" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET /colaboradores/{cpf}&lt;/b&gt;&lt;/font&gt;&lt;br&gt;acha o código da pessoa no RP Info pelo CPF (CPF igual nos dois · N7)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="926" width="540" height="52" as="geometry"/></mxCell><mxCell id="v59" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /v1.2/funcionario/codcpf/{codcpf}&lt;/b&gt;&lt;/font&gt;&lt;br&gt;consulta só a pessoa que está na folha' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="926" width="480" height="52" as="geometry"/></mxCell><mxCell id="e60" value="consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v58" target="v59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v61" value='&lt;b&gt;CPF&lt;/b&gt; vem junto com a folha&lt;br&gt;cadastro: DataServer &lt;font face="Courier New"&gt;&lt;b&gt;FopFuncData&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="99" y="926" width="330" height="52" as="geometry"/></mxCell><mxCell id="e62" value="CPF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v61" target="v58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v63" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ C4&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /colaboradores&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cadastra quem está na folha e ainda não existe no RP Info' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="992" width="540" height="52" as="geometry"/></mxCell><mxCell id="v64" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v1.0/funcionario&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cadastro de colaborador novo' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="992" width="480" height="52" as="geometry"/></mxCell><mxCell id="e65" value="cadastra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v63" target="v64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v66" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET · PUT /cadastros/de-para/{lojas|contas}&lt;/b&gt;&lt;/font&gt;&lt;br&gt;tabelas lojas e contas RM ↔ RP Info (Controladoria)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="1058" width="540" height="52" as="geometry"/></mxCell><mxCell id="v67" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /v1.1/financeiro/planocontas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;confere se a conta existe no RP Info' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="1058" width="480" height="52" as="geometry"/></mxCell><mxCell id="e68" value="consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v66" target="v67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v69" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ N6 S8&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /pendencias/{competencia}/sincronizar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;as 17 lojas numa única execução' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="1140" width="540" height="52" as="geometry"/></mxCell><mxCell id="v70" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /v1.6/financeiro/pendenciasFinanceiras/…&lt;/b&gt;&lt;/font&gt;&lt;br&gt;convênio, quebra de caixa, vale café (sub-rota exata a confirmar)' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="1140" width="480" height="52" as="geometry"/></mxCell><mxCell id="e71" value="lê" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v69" target="v70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v72" value='&lt;font face="Courier New"&gt;&lt;b&gt;/wsDataServer/IwsDataServer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;&lt;b&gt;SaveRecord&lt;/b&gt;&lt;/font&gt; · &lt;font face="Courier New"&gt;&lt;b&gt;FopLancExternoData&lt;/b&gt;&lt;/font&gt; &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ S8&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="99" y="1140" width="330" height="52" as="geometry"/></mxCell><mxCell id="e73" value="grava desconto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v69" target="v72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v74" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓ N2&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /pendencias/{competencia}/baixar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;baixa o convênio no RP Info depois do desconto' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="1206" width="540" height="52" as="geometry"/></mxCell><mxCell id="v75" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v2.0/financeiro/pendenciasFinanceiras/baixarPendenciaFin&lt;/b&gt;&lt;/font&gt;&lt;br&gt;baixa de pendências &lt;font color="#c0392b"&gt;&lt;b&gt;⚠ R12&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;dashed=1;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1154" y="1206" width="480" height="52" as="geometry"/></mxCell><mxCell id="e76" value="baixa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v74" target="v75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v77" value='&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET /execucoes/{id}  ·  GET /saude&lt;/b&gt;&lt;/font&gt;&lt;br&gt;histórico de cada execução: o que entrou, o que saiu, quem aprovou, recibo do RP Info' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="1286" width="540" height="52" as="geometry"/></mxCell><mxCell id="v78" value='&lt;b&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;✅&lt;/b&gt;&lt;/font&gt; 7 caminhos nossos certos&lt;/b&gt; — só dependem de nós&lt;br&gt;/folha/{competencia}/iniciar · /validar · /aprovar · /conferencia&lt;br&gt;/colaboradores/{cpf} · /cadastros/de-para · /execucoes' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1374" width="560" height="100" as="geometry"/></mxCell><mxCell id="v79" value='&lt;b&gt;&lt;font color="#c0392b"&gt;&lt;b&gt;❓ &lt;/b&gt;&lt;/font&gt;8 caminhos nossos que falta validar&lt;/b&gt; — cada um depende de uma resposta&lt;br&gt;&lt;b&gt;S7&lt;/b&gt; → /eventos/rm/folha-fechada · &lt;b&gt;S1/S3&lt;/b&gt; → /folha/…/enviar &lt;i&gt;ou&lt;/i&gt; /folha/…/arquivo (só um dos dois vai existir) · &lt;b&gt;S2&lt;/b&gt; → /folha/…/estornar&lt;br&gt;&lt;b&gt;N2&lt;/b&gt; → /folha/…/pos-importacao e /pendencias/…/baixar · &lt;b&gt;C4&lt;/b&gt; → POST /colaboradores · &lt;b&gt;N6/S8&lt;/b&gt; → /pendencias/…/sincronizar' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="596" y="1374" width="1058" height="100" as="geometry"/></mxCell><mxCell id="v80" value="Códigos das perguntas: S1–S8, N2, N6, N7 em 5-POC-API/PERGUNTAS-PRIORITARIAS.md · C4, R11–R13 em 5-POC-API/CONTRATO-DE-DADOS.md" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1490" width="1640" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>