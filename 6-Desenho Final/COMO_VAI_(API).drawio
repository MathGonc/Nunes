<mxfile host="drawio" agent="Claude Code"><diagram id="Como-vai-ficar-(API)" name="Como vai ficar (API)"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1490" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;COMO VAI FICAR (API)&lt;/b&gt; — arquitetura da integração TOTVS RM ⇄ RP Info" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1640" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Servidor de Integração dedicado · API REST &lt;b&gt;/api/v1&lt;/b&gt; · cada linha mostra um caminho do Servidor de Integração e a chamada que ele faz no TOTVS RM ou no RP Info" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1640" height="26" as="geometry"/></mxCell><mxCell id="v3" value="RP Info: RP Services API v2.0.89 (REST, token) · TOTVS RM: wsDataServer (SOAP, usuário de serviço)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="1640" height="24" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="36" height="24" as="geometry"/></mxCell><mxCell id="v5" value="caminho do &lt;b&gt;fluxo principal&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="62" y="112" width="190" height="36" a