ica;fontSize=12;horizontal=0;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1272" width="44" height="80" as="geometry"/></mxCell><mxCell id="v28" value="" style="line;strokeWidth=1;dashed=1;strokeColor=#9e9e9e;html=1;" vertex="1" parent="1"><mxGeometry x="64" y="1267" width="1590" height="10" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;Cofre de credenciais&lt;/b&gt;&lt;br&gt;token do RP Info e usuário de serviço do RM, renovados automaticamente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="234" width="540" height="52" as="geometry"/></mxCell><mxCell id="v30" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v1.2/auth&lt;/b&gt;&lt;/font&gt;&lt;br&gt;devolve o token usado em todas as chamadas' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="234" width="480" height="52" as="geometry"/></mxCell><mxCell id="e31" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v32" value="&lt;b&gt;Usuário de serviço&lt;/b&gt; no RM&lt;br&gt;autenticação do wsDataServer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="99" y="234" width="330" height="52" as="geometry"/></mxCell><mxCell id="e33" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v34" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /eventos/rm/folha-fechada&lt;/b&gt;&lt;/font&gt;&lt;br&gt;recebe o aviso de folha fechada (agendamento como alternativa)&lt;br&gt;&lt;font color="#b26a00"&gt;&lt;b&gt;&lt;i&gt;(A depender do RM enviar o aviso de fechamento)&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="312" width="540" height="60" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Evento de folha fechada&lt;/b&gt;&lt;br&gt;dispara a integração" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="99" y="316" width="330" height="52" as="geometry"/></mxCell><mxCell id="e36" value="avisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v35" target="v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v37" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/iniciar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;inicia a carga: por evento, por agendamento ou manualmente' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="382" width="540" height="52" as="geometry"/></mxCell><mxCell id="v38" value='&lt;font face="Courier New"&gt;&lt;b&gt;/wsDataServer/IwsDataServer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;&lt;b&gt;ReadView&lt;/b&gt;&lt;/font&gt; · lançamentos contábeis da folha' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="99" y="382" width="330" height="52" as="geometry"/></mxCell><mxCell id="e39" value="lê a folha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v37" target="v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v40" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/validar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;regras + de-para + débito = crédito por loja · &lt;b&gt;trava se algo não bater&lt;/b&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="448" width="540" height="52" as="geometry"/></mxCell><mxCell id="v41" value="&lt;i&gt;usa os caminhos de funcionários e cadastros (linha 2)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontColor=#666666;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="448" width="480" height="52" as="geometry"/></mxCell><mxCell id="v42" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/aprovar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;aprovação do lote do mês pelo responsável' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="514" width="540" height="52" as="geometry"/></mxCell><mxCell id="v43" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/enviar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;grava os lançamentos: 17 documentos, 1 por loja&lt;br&gt;&lt;font color="#b26a00"&gt;&lt;b&gt;&lt;i&gt;(A depender do RP Info aceitar a folha via API)&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="576" width="540" height="60" as="geometry"/></mxCell><mxCell id="v44" value='&lt;font face="Courier New"&gt;&lt;b&gt;POST /v1.0/fde&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DocumentoFDE · contrapartidas[] = os lançamentos' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="580" width="480" height="52" as="geometry"/></mxCell><mxCell id="e45" value="envia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v43" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v46" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;GET /folha/{competencia}/arquivo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;contingência: gera o arquivo de importação pronto, sem planilha&lt;br&gt;&lt;font color="#b26a00"&gt;&lt;b&gt;&lt;i&gt;(A depender do RP Info não aceitar a folha via API)&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="642" width="540" height="60" as="geometry"/></mxCell><mxCell id="v47" value="Importação do arquivo gerado (Ctrl+D)&lt;br&gt;sem planilha e sem digitação" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="646" width="480" height="52" as="geometry"/></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v46" target="v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v49" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /folha/{competencia}/conferencia&lt;/b&gt;&lt;/font&gt;&lt;br&gt;lê o que foi gravado e compara com o que foi enviado' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="712" width="540" height="52" as="geometry"/></mxCell><mxCell id="v50" value='&lt;font face="Courier New"&gt;&lt;b&gt;GET /v1.0/contabil/movimentos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;filtrado por competência e loja' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="712" width="480" height="52" as="geometry"/></mxCell><mxCell id="e51" value="lê" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v49" target="v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v52" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓&lt;/b&gt;&lt;/font&gt;&amp;nbsp; &lt;font face="Courier New"&gt;&lt;b&gt;POST /folha/{competencia}/estornar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;desfaz um envio inteiro (reprocesso)&lt;br&gt;&lt;font color="#b26a00"&gt;&lt;b&gt;&lt;i&gt;(A depender do RP Info permitir cancelar o lote)&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="524" y="774" width="540" height="60" as="geometry"/></mxCell><mxCell id="v53" value='&lt;font face="Courier New"&gt;&lt;b&gt;PUT /v1.0/documento/cancelar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cancela o lote enviado' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1154" y="778" width="480" height="52" as="geometry"/></mxCell><mxCell id="e54" value="cancela" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#7b5ea7;strokeWidth=2;fontColor=#5b3f75;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v52" target="v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v55" value='&lt;font color="#c0392b"&gt;&lt;b&gt;❓&lt;/b&