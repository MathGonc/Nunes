></mxCell><mxCell id="v48" value="11" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1068" y="708" width="26" height="26" as="geometry"/></mxCell><mxCell id="v49" value="&lt;b&gt;17 arquivos TXT&lt;/b&gt;&lt;br&gt;(1 por loja)&lt;br&gt;&lt;i&gt;layout documentado ≠ real&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="770" y="727" width="220" height="76" as="geometry"/></mxCell><mxCell id="v50" value='Importar o TXT na folha&lt;br&gt;&lt;b&gt;1 loja por vez&lt;/b&gt; → vira desconto&lt;br&gt;&lt;font color="#B85450"&gt;&lt;b&gt;17×&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="720" width="280" height="90" as="geometry"/></mxCell><mxCell id="v51" value="12" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="708" width="26" height="26" as="geometry"/></mxCell><mxCell id="v52" value="Erro “código do empregado inválido”:&lt;br&gt;abrir o TXT, achar a pessoa pelo ponto&lt;br&gt;no RP Info, corrigir à mão e &lt;b&gt;reimportar&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="860" width="340" height="80" as="geometry"/></mxCell><mxCell id="v53" value="13" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="438" y="848" width="26" height="26" as="geometry"/></mxCell><mxCell id="v54" value='• Salvar relatório &lt;b&gt;por loja&lt;/b&gt; com subtotal por funcionário &lt;font color="#B85450"&gt;&lt;b&gt;17×&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Baixar convênio (doc 3535) e adiantamentos, &lt;b&gt;invertendo até zerar&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1080" y="860" width="490" height="80" as="geometry"/></mxCell><mxCell id="v55" value="14-15" style="rounded=1;arcSize=50;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1068" y="848" width="44" height="26" as="geometry"/></mxCell><mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v45" target="v47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" value="salvar na&lt;br&gt;pasta de rede" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v47" target="v49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e58" value="importar à mão" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v49" target="v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e59" value="se der erro: corrigir e reimportar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;startArrow=block;startFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v50" target="v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e60" value="depois das 17 lojas, volta ao RP Info para conferir e baixar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v50" target="v54"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="995"/><mxPoint x="1325" y="995"/></Array></mxGeometry></mxCell><mxCell id="v61" value='&lt;b&gt;~43 arquivos&lt;/b&gt; gerados ou atualizados&lt;br&gt;à mão por mês&lt;br&gt;&lt;font color="#777777"&gt;7 na folha + 36 nas pendências&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1046" width="382" height="84" as="geometry"/></mxCell><mxCell id="v62" value='&lt;b&gt;15 retrabalhos&lt;/b&gt; manuais por mês&lt;br&gt;&lt;font color="#777777"&gt;4 deles repetidos loja a loja (até 17×)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="416" y="1046" width="382" height="84" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;Conferência no olho&lt;/b&gt;, em várias telas,&lt;br&gt;e &lt;b&gt;nenhuma trava&lt;/b&gt;: o RP Info aceitou&lt;br&gt;um arquivo diferente do gerado" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="812" y="1046" width="382" height="84" as="geometry"/></mxCell><mxCell id="v64" value='&lt;b&gt;Depende de 1 pessoa&lt;/b&gt;&lt;br&gt;&lt;font color="#777777"&gt;o relatório de pendências só está&lt;br&gt;liberado para 1 usuário&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#B85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1208" y="1046" width="382" height="84" as="geometry"/></mxCell><mxCell id="v65" value="N" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1154" width="26" height="26" as="geometry"/></mxCell><mxCell id="v66" value="retrabalho manual — numerado como no RESUMO-COMPARATIVO.md" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="52" y="1150" width="380" height="34" as="geometry"/></mxCell><mxCell id="v67" value="" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="1150" width="30" height="34" as="geometry"/></mxCell><mxCell id="v68" value="arquivo intermediário" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="488" y="1150" width="160" height="34" as="geometry"/></mxCell><mxCell id="e69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="1167" as="sourcePoint"/><mxPoint x="720" y="1167" as="targetPoint"/></mxGeometry></mxCell><mxCell 