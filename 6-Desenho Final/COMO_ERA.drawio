<mxfile host="drawio" agent="Claude Code"><diagram id="Como-era" name="Como era"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;COMO ERA&lt;/b&gt; — Domínio ⇄ RP Info por arquivos, planilha e digitação" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1570" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Fechamento mensal · prazo: 5º dia útil · 17 lojas · 1.078 colaboradores · 7.853 lançamentos · R$ 2,6 milhões (competência 08/2026)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1570" height="26" as="geometry"/></mxCell><mxCell id="v3" value="DOMÍNIO · calcula a folha" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="340" height="44" as="geometry"/></mxCell><mxCell id="v4" value="TRABALHO MANUAL · arquivos, planilhas e pasta de rede" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d79b00;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="620" height="44" as="geometry"/></mxCell><mxCell id="v5" value="RP INFO (RP One / Mix) · contabilidade e financeiro" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#5f8f4e;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="540" height="44" as="geometry"/></mxCell><mxCell id="v6" value="" sty