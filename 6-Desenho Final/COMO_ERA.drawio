ll><mxCell id="v14" value="Fechar a folha" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="280" height="44" as="geometry"/></mxCell><mxCell id="v15" value='Rubrica nova?&lt;br&gt;Configurar &lt;b&gt;loja por loja&lt;/b&gt;&lt;br&gt;&lt;font color="#B85450"&gt;&lt;b&gt;até 17×&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="228" width="280" height="70" as="geometry"/></mxCell><mxCell id="v16" value="1" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="216" width="26" height="26" as="geometry"/></mxCell><mxCell id="v17" value="Exportar o &lt;b&gt;TXT da folha&lt;/b&gt; e&lt;br&gt;&lt;b&gt;2 relatórios&lt;/b&gt; (Integração Contábil&lt;br&gt;e Resumo Mensal)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="322" width="280" height="84" as="geometry"/></mxCell><mxCell id="v18" value="2 relatórios em Excel&lt;br&gt;+ planilha &lt;b&gt;Análise&lt;/b&gt;&lt;br&gt;conferência &lt;b&gt;no olho&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="v19" value="2" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="438" y="148" width="26" height="26" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;TXT da folha&lt;/b&gt;&lt;br&gt;6.849 linhas" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="336" width="150" height="70" as="geometry"/></mxCell><mxCell id="v21" value="Plano Gerencial RP.txt&lt;br&gt;(plano de contas)" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="422" width="150" height="50" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Planilha Excel&lt;/b&gt;&lt;br&gt;8 consultas Power Query&lt;br&gt;&lt;i&gt;as regras de negócio só existem aqui&lt;/i&gt;&lt;br&gt;nome divergente →&lt;br&gt;&lt;b&gt;código digitado à mão&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="210" height="114" as="geometry"/></mxCell><mxCell id="v23" value="4" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="618" y="288" width="26" height="26" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;CSV&lt;/b&gt; UTF-8&lt;br&gt;reabrir e &lt;b&gt;apagar o&lt;br&gt;cabeçalho à mão&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="865" y="332" width="160" height="78" as="geometry"/></mxCell><mxCell id="v25" value="5" style="ellipse;html=1;fillColor=#e51400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="853" y="320" width="26" height="26" as="geometry"/></mxCell><mxCell id="v26" value="Importar o CSV (Ctrl+D)&lt;br&gt;e conferir os totais&lt;br&gt;&lt;b&gt;na tela&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeCo