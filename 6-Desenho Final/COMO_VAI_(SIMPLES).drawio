<mxfile host="drawio" agent="Claude Code"><diagram id="Como-vai-ficar" name="Como vai ficar"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;COMO VAI FICAR&lt;/b&gt; — TOTVS RM ⇄ RP Info direto por API" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1570" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Sem arquivo intermediário · sem planilha · sem redigitação · erro trava o envio antes de chegar ao destino" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1570" height="26" as="geometry"/></mxCell><mxCell id="v3" value="TOTVS RM · calcula a folha" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#0e8088;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="440" height="44" as="geometry"/></mxCell><mxCell id="v4" value="INTEGRAÇÃO POR API · automática, sem pessoas no meio" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#7b5ea7;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="440" height="44" as="geometry"/></mxCell><mxCell id="v5" value="RP INFO (RP One / Mix) · contabilidade e financeiro" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#5f8f4e;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="540" height="44" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#eaf6f7;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="70" y="134" width="440" height="686" as="geometry"/></mxCell><mxCell id="v7" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f1fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="134" width="440" height="686" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f0f7ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="134" width="540" height="686" as="geometry"/></mxCell><mxCell id="v9" value="1 · FOLHA  (RM → RP Info)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;horizontal=0;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="134" width="44" height="270" as="geometry"/></mxCell><mxCell id="v10" value="2 · FUNCIONÁRIOS" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;horizontal=0;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="44" height="190" as="geometry"/></mxCell><mxCell id="v11" value="3 · PENDÊNCIAS  (RP Info → RM)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;horizontal=0;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="594" width="44" height="226" as="geometry"/></mxCell><mxCell id="v12" value="" style="line;strokeWidth=1;dashed=1;strokeColor=#9e9e9e;html=1;" vertex="1" parent="1"><mxGeometry x="64" y="399" width="1526" height="10" as="geometry"/></mxCell><mxCell id="v13" value="" style="line;strokeWidth=1;dashed=1;strokeColor=#9e9e9e;html=1;" vertex="1" parent="1"><mxGeometry x="64" y="589" width="1526" height="10" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Folha fechada&lt;/b&gt; no TOTVS RM&lt;br&gt;&lt;i&gt;o fechamento dispara a integração&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="380" height="90" as="geometry"/></mxCell><mxCell id="v15" value='&lt;b&gt;Recebe a folha&lt;/b&gt; e aplica as regras&lt;br&gt;(lojas e contas em cadastro, não em planilha)&lt;br&gt;&lt;br&gt;&lt;b&gt;Confere sozinha&lt;/b&gt;: débito = crédito, loja por loja,&lt;br&gt;toda pessoa e toda rubrica reconhecidas&lt;br&gt;&lt;br&gt;&lt;font color="#B85450"&gt;&lt;b&gt;Se houver erro, trava o envio&lt;/b&gt;&lt;/font&gt;&lt;br&gt;e mostra o quê e de quem&lt;br&gt;&lt;br&gt;Guarda o histórico de cada envio' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="160" width="380" height="200" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Lançamentos contábeis&lt;/b&gt;&lt;br&gt;gravados direto&lt;br&gt;sem CSV, sem Ctrl+D" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="165" width="230" height="90" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Pós-importação&lt;/b&gt; por API&lt;br&gt;bancos, pensão e baixas&lt;br&gt;&lt;i&gt;módulo opcional&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1340" y="165" width="230" height="90" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Conferência automática&lt;/b&gt;: a integração lê o que foi gravado&lt;br&gt;e compara com o que foi enviado — ninguém confere na tela" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="285" width="490" height="70" as="geometry"/></mxCell><mxCell id="e19" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="confere" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontColor=#5b3f75;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="v18" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v23" value="&lt;b&gt;CPF&lt;/b&gt; de cada colaborador" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="100" y="459" width="380" height="80" as="geometry"/></mxCell><mxCell id="v24" value="Identifica cada pessoa pelo &lt;b&gt;CPF&lt;/b&gt;&lt;br&gt;consulta só quem está na folha" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="459" width="380" height="80" as="geometry"/></mxCell><mxCell id="v25" value="Cadastro de funcionários&lt;br&gt;consulta pontual &lt;b&gt;por CPF&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="449" width="250" height="100" as="geometry"/></mxCell><mxCell id="v26" value="&lt;s&gt;dfunc.txt na pasta de rede&lt;/s&gt;&lt;br&gt;&lt;s&gt;base inteira baixada todo mês&lt;/s&gt;&lt;br&gt;&lt;b&gt;deixa de existir&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1350" y="449" width="220" height="100" as="geometry"/></mxCell><mxCell id="e27" value="CPF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v23" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="CPF → código" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v29" value="&lt;b&gt;Pendências&lt;/b&gt; de convênio, quebra de caixa e vale café&lt;br&gt;das 17 lojas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="662" width="490" height="90" as="geometry"/></mxCell><mxCell id="v30" value="Lê as pendências das &lt;b&gt;17 lojas numa única execução&lt;/b&gt;&lt;br&gt;confere e trava se algo não bater" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="662" width="380" height="90" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;Desconto lançado direto na folha&lt;/b&gt;&lt;br&gt;sem TXT, sem importar loja por loja" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="100" y="662" width="380" height="90" as="geometry"/></mxCell><mxCell id="e32" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v29" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=3;fontColor=#5b3f75;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v34" value='&lt;b&gt;0 arquivos&lt;/b&gt; intermediários&lt;br&gt;&lt;font color="#777777"&gt;antes: ~43 por mês&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#5f8f4e;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="846" width="382" height="80" as="geometry"/></mxCell><mxCell id="v35" value='&lt;b&gt;0 retrabalhos&lt;/b&gt; de digitação&lt;br&gt;&lt;font color="#777777"&gt;antes: 15 por mês, 4 deles 17×&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#5f8f4e;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="416" y="846" width="382" height="80" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;Conferência automática&lt;/b&gt;&lt;br&gt;erro trava o envio antes&lt;br&gt;de chegar ao destino" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#5f8f4e;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="812" y="846" width="382" height="80" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Dados pessoais&lt;/b&gt; fora da pasta de rede&lt;br&gt;identificação pelo CPF, não pelo nome" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#5f8f4e;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1208" y="846" width="382" height="80" as="geometry"/></mxCell><mxCell id="v38" value="&lt;b&gt;O que continua com pessoas:&lt;/b&gt; aprovar o envio do mês · classificar uma rubrica nova (uma vez, no cadastro — não 17×) · manter as tabelas de lojas e contas" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="942" width="1570" height="44" as="geometry"/></mxCell><mxCell id="v39" value="&lt;b&gt;Contingência prevista:&lt;/b&gt; se necessário, a integração gera o arquivo de importação automaticamente — também sem planilha e sem digitação." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="996" width="1570" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>